# Database Password (Used for database migrations/management)
# WARNING: Do not use this in the browser, only for backend/CLI scripts
DB_PASS=your_database_password_here

# Supabase URL (Found in Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (Found in Project Settings > API)
# This is safe to be exposed in the frontend
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# NOTE: VITE_SUPABASE_PUBLISHABLE_KEY is typically the same as VITE_SUPABASE_ANON_KEY 
# in Supabase setups. If you need it for specific SDKs, you can set it here:
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here